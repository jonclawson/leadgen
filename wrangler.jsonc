    "production": {
      "vars": {
        "NODE_ENV": "production",
        "ENVIRONMENT": "production",
        "BETTER_AUTH_URL": "https://leadgen.example.com",
        "VITE_AUTH_URL": "https://leadgen.example.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "leadgen",
          "migrations_dir": "prisma/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "leadgen-prod"
        }
      ]
    }
  },

