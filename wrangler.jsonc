{
  "name": "leadgen_analog_app",
  // "type": "service",
  // "main": "dist/server/index.mjs",
  "compatibility_date": "2024-12-16",
  
  // Pages Functions configuration
  "pages_build_output_dir": "dist/analog",
  
  // Environment-specific configuration
  "env": {
    // "development": {
    //   "vars": {
    //     "NODE_ENV": "development",
