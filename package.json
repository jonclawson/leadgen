{
  "name": "analog_app",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build",
    "build:cf": "NODE_ENV=production && vite build -c vite.cloudflare.config.ts",
    "dev:cf": "wrangler pages dev dist/analog",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "node -r dotenv/config dist/analog/server/index.mjs",
    "seed": "tsx prisma/seed.ts",
    "deploy:cf": "npm run build:cf && wrangler pages deploy",
    "db:migrate:create": "node scripts/migrate.js",
    "db:migrate:local": "wrangler d1 migrations apply leadgen --local --env production",
    "db:migrate:deploy": "wrangler d1 migrations apply leadgen --remote --env production",
    "migrate:cf": "npx wrangler d1 migrations apply leadgen --remote --env production "
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.2.3",
    "@analogjs/router": "^2.2.3",
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "~21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-d1": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@stripe/stripe-js": "^9.9.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-subscript": "^3.27.3",
    "@tiptap/extension-superscript": "^3.27.3",
    "@tiptap/extension-table": "^3.27.3",
    "@tiptap/extension-table-cell": "^3.27.3",
    "@tiptap/extension-table-header": "^3.27.3",
    "@tiptap/extension-table-row": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.18",
    "dotenv": "^17.3.1",
    "front-matter": "^4.0.2",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "ngx-tiptap": "^14.0.1",
    "pg": "^8.13.1",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "stripe": "^22.3.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.2.3",
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@analogjs/vitest-angular": "^2.2.3",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/material": "^21.1.5",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.11.10",
    "jsdom": "^22.0.0",
    "prisma": "^7.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.110.0"
  }
}
