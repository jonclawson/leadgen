// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String?
  messages          Message[]
  emailVerified     Boolean             @default(false)
  image             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sessions          Session[]
  accounts          Account[]
  dynamicForms      DynamicForm[]
  articles          Article[]
  formSubmissions   FormSubmission[]

  @@map("user")
}

model Message {
  id     String    @id @default(cuid())
  body   String
  author User   @relation(fields: [userId], references: [id])
  userId String
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model DynamicForm {
  id          String                @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fields      FormFieldDefinition[]
  articles    Article[]
  submissions FormSubmission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId])
  @@map("dynamic_form")
}

model FormFieldDefinition {
  id            String      @id @default(cuid())
  dynamicFormId String
  dynamicForm   DynamicForm @relation(fields: [dynamicFormId], references: [id], onDelete: Cascade)
  type          String      // 'email' | 'password' | 'button' | 'textarea' | 'select' | 'checkbox' | 'radio'
  key           String
  label         String?
  icon          String?
  placeholder   String?
  validators    String?     // CSV string like "required,email,minLength:8"
  options       String?     // JSON string for select/radio options or field config
  buttonLabel   String?
  buttonColor   String?     // 'primary' | 'accent' | 'warn'
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([dynamicFormId])
  @@map("form_field_definition")
}

model Article {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  body        String
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  formId      String?
  form        DynamicForm?        @relation(fields: [formId], references: [id], onDelete: SetNull)
  submissions FormSubmission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([slug])
  @@index([formId])
  @@map("article")
}

model FormSubmission {
  id        String      @id @default(cuid())
  formId    String
  form      DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  articleId String
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String      // JSON string with form submission data
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([formId])
  @@index([articleId])
  @@index([createdAt])
  @@map("form_submission")
}
